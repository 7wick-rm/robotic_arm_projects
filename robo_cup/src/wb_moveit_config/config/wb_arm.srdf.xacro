<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wb_arm">
  <xacro:arg name="prefix" default=""/>

  <group name="arm">
    <chain base_link="${prefix}base_link" tip_link="${prefix}gripper_base"/>
  </group>
  <group name="gripper">
    <joint name="${prefix}gripper_hand_1_joint"/>
    <joint name="${prefix}gripper_hand_2_joint"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="${prefix}Link_1_joint" value="0"/>
    <joint name="${prefix}Link_2_joint" value="0"/>
    <joint name="${prefix}link_3_joint" value="0"/>
    <joint name="${prefix}link_4_joint" value="0"/>
  </group_state>

  <end_effector name="end_effector" parent_link="${prefix}gripper_base"
    group="gripper" parent_group="arm"/>

  <disable_collisions link1="${prefix}Link_1" link2="${prefix}Link_2" reason="Adjacent"/>
  <disable_collisions link1="${prefix}Link_1" link2="${prefix}base_link" reason="Adjacent"/>
  <disable_collisions link1="${prefix}Link_2" link2="${prefix}link_3" reason="Adjacent"/>
  <disable_collisions link1="${prefix}gripper_base" link2="${prefix}gripper_hand_1" reason="Adjacent"/>
  <disable_collisions link1="${prefix}gripper_base" link2="${prefix}gripper_hand_2" reason="Adjacent"/>
  <disable_collisions link1="${prefix}gripper_base" link2="${prefix}link_3" reason="Never"/>
  <disable_collisions link1="${prefix}gripper_base" link2="${prefix}link_4" reason="Adjacent"/>
  <disable_collisions link1="${prefix}gripper_hand_1" link2="${prefix}gripper_hand_2" reason="Never"/>
  <disable_collisions link1="${prefix}gripper_hand_1" link2="${prefix}link_3" reason="Never"/>
  <disable_collisions link1="${prefix}gripper_hand_1" link2="${prefix}link_4" reason="Never"/>
  <disable_collisions link1="${prefix}gripper_hand_2" link2="${prefix}link_3" reason="Never"/>
  <disable_collisions link1="${prefix}gripper_hand_2" link2="${prefix}link_4" reason="Never"/>
  <disable_collisions link1="${prefix}link_3" link2="${prefix}link_4" reason="Adjacent"/>
</robot>