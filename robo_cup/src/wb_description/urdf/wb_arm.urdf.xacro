<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wb_arm">

  <xacro:arg name="is_ignition" default="True"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="robot_name" default="robot1"/>
  <xacro:arg name="controllers_file"
    default="$(find wb_moveit_config)/config/ros2_controllers_robot1.yaml"/>

  <xacro:property name="prefix" value="$(arg prefix)"/>

  <xacro:include filename="$(find wb_description)/urdf/wb_arm_urdf.xacro"/>
  <xacro:include filename="$(find wb_description)/urdf/ros2control.xacro"/>
  <xacro:include filename="$(find wb_description)/urdf/gazebo.xacro"/>

  <xacro:ros2_control_block prefix="$(arg prefix)"/>
  <xacro:gazebo_block prefix="$(arg prefix)"/>

</robot>




