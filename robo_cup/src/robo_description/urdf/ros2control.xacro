<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="ros2_control_block">

    <ros2_control name="GazeboSystem" type="system">

        <!-- ros2_control Gazebo -->
        <!-- ROS 2 Humble -->
        <xacro:if value="$(arg is_ignition)">
        <hardware>
            <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </hardware>
        </xacro:if>

        <!-- ROS 2 Iron or above -->
        <xacro:unless value="$(arg is_ignition)">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        </xacro:unless>

      <!-- ARM -->
      <joint name="base_link_Revolute-107">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="DOF1motor_Revolute-110">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="dof_link_1_motor_Revolute-111">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="dof_link_1_motor-1_Revolute-112">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="dof_5_link-1_Revolute-113">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="dof_6_ass_Revolute-114">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- GRIPPER -->
      <joint name="gripper_withoutarm_part_Slider-116">
        <command_interface name="position">
          <param name="min">-0.05</param>
          <param name="max">0.05</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="gripper_withoutarm_part_Slider-121">
        <command_interface name="position">
          <param name="min">-0.05</param>
          <param name="max">0.05</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>


      <!-- WHEELS — passive, no command interface, just state -->
      <!-- <joint name="base_link_Revolute-105">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="base_link_Revolute-118">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="base_link_Revolute-119">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="base_link_Revolute-120">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint> -->

    </ros2_control>

  </xacro:macro>

</robot>