<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="piper_ros2_control" params="
    name
    prefix
    mujoco_model_path:=''
    include_gripper:=true
    mock_hardware:=false
    mujoco:=true
    fake_sensor_commands:=false
    joint_state_topic_hardware:=false
    joint_commands_topic:=/joint_commands_topic
    joint_states_topic:=/joint_states_topic
    initial_positions:=${dict(joint_1=0.0,joint_2=0.01,joint_3=-0.01,joint_4=0.0,joint_5=0.0,joint_6=0.0)}">
  
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${mujoco}">
          <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        </xacro:if>
        <!-- This supports Isaac sim and Hardware -->
        <xacro:if value="${joint_state_topic_hardware}">
          <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
          <param name="joint_commands_topic">${joint_commands_topic}</param>
          <param name="joint_states_topic">${joint_states_topic}</param>
        </xacro:if>
        <xacro:if value="${mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="fake_sensor_commands">${fake_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
      </hardware>

      <joint name="${prefix}joint_1">
        <xacro:if value="${mujoco}">
          <command_interface name="position"/>
        </xacro:if>
        <xacro:unless value="${mujoco}">
          <command_interface name="position">
          <param name="min">-2.618</param>
          <param name="max">2.618</param>
        </command_interface>
        </xacro:unless>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_1']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_2">
      <xacro:if value="${mujoco}">
        <command_interface name="position"/>
      </xacro:if>
      <xacro:unless value="${mujoco}">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">${pi}</param>
        </command_interface>
      </xacro:unless>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_2']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_3">
      <xacro:if value="${mujoco}">
        <command_interface name="position"/>
      </xacro:if>
      <xacro:unless value="${mujoco}">
        <command_interface name="position">
          <param name="min">-2.967</param>
          <param name="max">0</param>
        </command_interface>
      </xacro:unless>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_3']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_4">
      <xacro:if value="${mujoco}">
        <command_interface name="position"/>
      </xacro:if>
      <xacro:unless value="${mujoco}">
        <command_interface name="position">
          <param name="min">-1.832</param>
          <param name="max">1.832</param>
        </command_interface>
      </xacro:unless>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_4']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_5">
      <xacro:if value="${mujoco}">
        <command_interface name="position"/>
      </xacro:if>
      <xacro:unless value="${mujoco}">
        <command_interface name="position">
          <param name="min">-1.22</param>
          <param name="max">1.22</param>
        </command_interface>
      </xacro:unless>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_5']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_6">
      <xacro:if value="${mujoco}">
        <command_interface name="position"/>
      </xacro:if>
      <xacro:unless value="${mujoco}">
        <command_interface name="position">
          <param name="min">-${pi}</param>
          <param name="max">${pi}</param>
        </command_interface>
      </xacro:unless>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_6']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}gripper_joint">
      <xacro:if value="${mujoco}">
        <command_interface name="position"/>
      </xacro:if>
      <xacro:unless value="${mujoco}">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.038</param>
        </command_interface>
      </xacro:unless>
          <state_interface name="position">
            <param name="initial_value">0.016</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="${prefix}mimic_gripper_joint">
        <xacro:if value="${mujoco}">
          <command_interface name="position"/>
        </xacro:if>
        <xacro:unless value="${mujoco}">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">0.038</param>
          </command_interface>
        </xacro:unless>
          <state_interface name="position">
            <param name="initial_value">0.016</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      
      <sensor name="ft_sensor_fts">
        <state_interface name="force.x"/>
        <state_interface name="force.y"/>
        <state_interface name="force.z"/>
        <state_interface name="torque.x"/>
        <state_interface name="torque.y"/>
        <state_interface name="torque.z"/>
        <param name="frame_id">ft_sensor</param>
      </sensor>

    </ros2_control>
  </xacro:macro>

</robot>
