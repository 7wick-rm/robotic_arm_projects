<?xml version="1.0" ?>
<robot name="assembly_final_done_pakka" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <link name="camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="0.1"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <!-- <visual>
            <origin xyz="-0.08 -0.35 -0.5" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <material name="red"/>
        </visual> -->
        <collision>
            <origin xyz="-0.08 -0.35 -0.3" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <material name="red"/>
        </collision>
    </link>
    
    <joint name="camera_joint" type="fixed">
        <origin xyz="0.6 0 0.8" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>
    
    <link name="camera_link_optical" />
    
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose>-0.08 -0.35 -0.3 0 1.57 0</pose>
            <visualize>true</visualize>
            <update_rate>30.0</update_rate>
            <alwaysOn>true</alwaysOn>
            <topic>camera/image_raw</topic>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera name="intel_realsense_r200">
                <camera_info_topic>camera/camera_info</camera_info_topic>
                <horizontal_fov>1.1</horizontal_fov>
                <image>
                    <width>1200</width>
                    <height>720</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <!-- ========== DEPTH CAMERA ========== -->
    <link name="depth_camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <!-- <visual>
            <origin xyz="-0.08 -0.35 -0.3" rpy="0 0 0"/>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <material name="blue"/>
        </visual> -->
        <collision>
            <origin xyz="-0.08 -0.35 -0.3" rpy="0 0 0"/>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
        </collision>
    </link>

    <!-- Mount depth camera right next to regular camera -->
    <joint name="depth_camera_joint" type="fixed">
        <origin xyz="0.6 0.0 0.8" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="depth_camera_link"/>
    </joint>

    <link name="depth_camera_link_optical"/>

    <joint name="depth_camera_optical_joint" type="fixed">
        <parent link="depth_camera_link"/>
        <child link="depth_camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- FIX 1: Changed type from "depth_camera" to "rgbd_camera" so that
         PointCloud2 output (/depth_camera/points) is actually published.
         FIX 2: Removed the misplaced <plugin> for ignition-gazebo-sensors-system
         that was incorrectly placed inside this <sensor> block. That plugin is
         a world-level system and is already loaded via server.config — adding it
         here caused a second render thread to spawn, crashing Gazebo. -->
    <gazebo reference="depth_camera_link">
        <sensor name="depth_camera" type="rgbd_camera">
            <pose>-0.08 -0.35 -0.3 0 1.57 0</pose>
            <visualize>true</visualize>
            <update_rate>30.0</update_rate>
            <alwaysOn>true</alwaysOn>
            <topic>depth_camera</topic>
            <gz_frame_id>aligned_depth_camera_link</gz_frame_id>
            <!-- <gz_frame_id>depth_camera_link_optical</gz_frame_id> -->
            <camera name="depth_camera">
                <camera_info_topic>depth_camera/camera_info</camera_info_topic>
                <horizontal_fov>1.1</horizontal_fov>
                <image>
                    <width>1920</width>
                    <height>1080</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

</robot>








