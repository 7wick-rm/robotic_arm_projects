<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="ros2_control_block">

    <!-- ================================================================
         REAL HARDWARE TEST MODE (real_hw_test:=true, no Gazebo)

           Joint3            -> BLDC (nmotion)      arm_bldc_controller/ArmBLDCSystem
           Joint4, Joint5,
           Jaw               -> AX-18A bus servos   arm_servo_controller/ArmServoHardware
           Joint1, Joint2    -> mock_components/GenericSystem
           Jaw2              -> not controlled; <mimic> of Jaw in the URDF
         ================================================================ -->
    <xacro:if value="$(arg real_hw_test)">

      <!-- Joint3 - nmotion BLDC. Own USB port, separate from the servo bus. -->
      <ros2_control name="ArmBLDCSystem" type="system">
        <hardware>
          <plugin>arm_bldc_controller/ArmBLDCSystem</plugin>
          <param name="device">/dev/ttyACM1</param>
        </hardware>

        <joint name="Joint3">
          <param name="node_id">0</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </ros2_control>

      <!-- Joint4, Joint5, Jaw - AX-18A daisy-chained on one serial bus -->
      <ros2_control name="ArmServoSystem" type="system">
        <hardware>
          <plugin>arm_servo_controller/ArmServoHardware</plugin>
          <param name="port">/dev/ttyACM0</param>
        </hardware>

        <joint name="Joint4">
          <command_interface name="position">
            <param name="min">-3.14</param>
            <param name="max">3.14</param>
          </command_interface>
          <state_interface name="position"/>
          <param name="id">3</param>
        </joint>

        <joint name="Joint5">
          <command_interface name="position">
            <param name="min">-3.14</param>
            <param name="max">3.14</param>
          </command_interface>
          <state_interface name="position"/>
          <param name="id">4</param>
        </joint>

        <!-- Gripper - binary open/close. The STM firmware moves the servo (GRIPPER id 0 or 1) and
             stops closing by itself when the grasp load passes its threshold, so ROS only picks
             the state. open_deg and close_deg are the servo angles at the two ends of travel,
             open_pos and close_pos are the matching Jaw values (same as the SRDF open and close). -->
        <joint name="Jaw">
          <command_interface name="position">
            <param name="min">-0.023</param>
            <param name="max">0.0</param>
          </command_interface>
          <state_interface name="position"/>
          <param name="id">2</param>
          <param name="type">binary_gripper</param>
          <param name="open_deg">60</param>
          <param name="close_deg">110</param>
          <param name="open_pos">0.0</param>
          <param name="close_pos">-0.023</param>
          <param name="gripper_hysteresis">0.1</param>
        </joint>
      </ros2_control>

      <!-- Joint1, Joint2 - not physically present yet -->
      <ros2_control name="MockArmSystem" type="system">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
        </hardware>

        <joint name="Joint1">
          <command_interface name="position">
            <param name="min">-3.14</param>
            <param name="max">3.14</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>

        <joint name="Joint2">
          <command_interface name="position">
            <param name="min">-3.14</param>
            <param name="max">3.14</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>
      </ros2_control>

    </xacro:if>

    <!-- ================================================================
         SIMULATION MODE (unchanged)
         ================================================================ -->
    <xacro:unless value="$(arg real_hw_test)">

      <ros2_control name="GazeboSystem" type="system">

        <!-- ROS 2 Humble -->
        <xacro:if value="$(arg is_ignition)">
          <hardware>
            <plugin>ign_ros2_control/IgnitionSystem</plugin>
          </hardware>
        </xacro:if>

        <!-- ROS 2 Iron or above -->
        <xacro:unless value="$(arg is_ignition)">
          <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
          </hardware>
        </xacro:unless>

        <joint name="Joint1">
          <command_interface name="position"><param name="min">-3.14</param><param name="max">3.14</param></command_interface>
          <state_interface name="position"/><state_interface name="velocity"/>
        </joint>
        <joint name="Joint2">
          <command_interface name="position"><param name="min">-3.14</param><param name="max">3.14</param></command_interface>
          <state_interface name="position"/><state_interface name="velocity"/>
        </joint>
        <joint name="Joint3">
          <command_interface name="position"><param name="min">-3.14</param><param name="max">3.14</param></command_interface>
          <state_interface name="position"/><state_interface name="velocity"/>
        </joint>
        <joint name="Joint4">
          <command_interface name="position"><param name="min">-3.14</param><param name="max">3.14</param></command_interface>
          <state_interface name="position"/><state_interface name="velocity"/>
        </joint>
        <joint name="Joint5">
          <command_interface name="position"><param name="min">-3.14</param><param name="max">3.14</param></command_interface>
          <state_interface name="position"/><state_interface name="velocity"/>
        </joint>
        <joint name="Jaw">
          <command_interface name="position"><param name="min">0</param><param name="max">0.1</param></command_interface>
          <state_interface name="position"/><state_interface name="velocity"/>
        </joint>
        <joint name="Jaw2">
          <command_interface name="position"><param name="min">-0.1</param><param name="max">0.0</param></command_interface>
          <state_interface name="position"/><state_interface name="velocity"/>
        </joint>

      </ros2_control>

    </xacro:unless>

  </xacro:macro>

</robot>