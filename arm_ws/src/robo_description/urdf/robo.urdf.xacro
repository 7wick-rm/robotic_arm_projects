<?xml version="1.0"?>
<robot name="assembly_final_done_pakka" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- INCLUDE FILES -->
  <xacro:include filename="$(find robo_description)/urdf/URDF_robo_bot.xacro"/>
  <xacro:include filename="$(find robo_description)/urdf/ros2control.xacro"/>
  <xacro:include filename="$(find robo_description)/urdf/gazebo.xacro"/>
  <xacro:include filename="$(find robo_description)/urdf/sensors.xacro"/>

  <!-- BUILD ROBOT -->
  <xacro:ros2_control_block/>
  <xacro:gazebo_block/>

</robot>
