<sdf version='1.9'>
  <world name='empty_world'>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name='sun' type='directional'>
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- =====================================================================
         STORAGE SHELF (per SML Fig. 6 - standardized 40cm x 90cm x 90cm shelf)
         Footprint: 0.9 m (X) x 0.4 m (Y), total height 0.9 m (Z)
         Two rows: bottom row ~ ground level (ground robots), top row ~ human
         operating height. Whole unit is static; move it by editing the single
         model <pose> below (currently placed at x=1.0, y=0.0).
         ===================================================================== -->
    <model name="storage_shelf_unit">
      <static>true</static>
      <pose>1.0 0.0 0.0 0 0 0</pose>

      <!-- 4 corner posts (cylindrical rods), full shelf height -->
      <link name="post_front_right">
        <pose>0.43 -0.18 0.45 0 0 0</pose>
        <collision name="post_front_right_collision">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.9</length></cylinder>
          </geometry>
        </collision>
        <visual name="post_front_right_visual">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.9</length></cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.52 1</ambient>
            <diffuse>0.5 0.5 0.52 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="post_front_left">
        <pose>0.43 0.18 0.45 0 0 0</pose>
        <collision name="post_front_left_collision">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.9</length></cylinder>
          </geometry>
        </collision>
        <visual name="post_front_left_visual">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.9</length></cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.52 1</ambient>
            <diffuse>0.5 0.5 0.52 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="post_back_right">
        <pose>-0.43 -0.18 0.45 0 0 0</pose>
        <collision name="post_back_right_collision">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.9</length></cylinder>
          </geometry>
        </collision>
        <visual name="post_back_right_visual">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.9</length></cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.52 1</ambient>
            <diffuse>0.5 0.5 0.52 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="post_back_left">
        <pose>-0.43 0.18 0.45 0 0 0</pose>
        <collision name="post_back_left_collision">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.9</length></cylinder>
          </geometry>
        </collision>
        <visual name="post_back_left_visual">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.9</length></cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.52 1</ambient>
            <diffuse>0.5 0.5 0.52 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Row 1: bottom shelf slab (ground level) -->
      <link name="shelf_row_bottom">
        <pose>0 0 0.05 0 0 0</pose>
        <collision name="shelf_row_bottom_collision">
          <geometry>
            <box><size>0.9 0.4 0.02</size></box>
          </geometry>
        </collision>
        <visual name="shelf_row_bottom_visual">
          <geometry>
            <box><size>0.9 0.4 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.72 0.58 0.40 1</ambient>
            <diffuse>0.72 0.58 0.40 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Row 2: top shelf slab (elevated / human operating height) -->
      <link name="shelf_row_top">
        <pose>0 0 0.85 0 0 0</pose>
        <collision name="shelf_row_top_collision">
          <geometry>
            <box><size>0.9 0.4 0.02</size></box>
          </geometry>
        </collision>
        <visual name="shelf_row_top_visual">
          <geometry>
            <box><size>0.9 0.4 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.72 0.58 0.40 1</ambient>
            <diffuse>0.72 0.58 0.40 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Hollow crate (open-top, thin-walled box) sitting on the bottom row -->
      <link name="crate_floor">
        <pose>0 0 0.065 0 0 0</pose>
        <collision name="crate_floor_collision">
          <geometry>
            <box><size>0.3 0.3 0.01</size></box>
          </geometry>
        </collision>
        <visual name="crate_floor_visual">
          <geometry>
            <box><size>0.3 0.3 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.82 0.66 0.45 1</ambient>
            <diffuse>0.82 0.66 0.45 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="crate_wall_front">
        <pose>0 0.145 0.13 0 0 0</pose>
        <collision name="crate_wall_front_collision">
          <geometry>
            <box><size>0.3 0.01 0.12</size></box>
          </geometry>
        </collision>
        <visual name="crate_wall_front_visual">
          <geometry>
            <box><size>0.3 0.01 0.12</size></box>
          </geometry>
          <material>
            <ambient>0.82 0.66 0.45 1</ambient>
            <diffuse>0.82 0.66 0.45 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="crate_wall_back">
        <pose>0 -0.145 0.13 0 0 0</pose>
        <collision name="crate_wall_back_collision">
          <geometry>
            <box><size>0.3 0.01 0.12</size></box>
          </geometry>
        </collision>
        <visual name="crate_wall_back_visual">
          <geometry>
            <box><size>0.3 0.01 0.12</size></box>
          </geometry>
          <material>
            <ambient>0.82 0.66 0.45 1</ambient>
            <diffuse>0.82 0.66 0.45 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="crate_wall_left">
        <pose>-0.145 0 0.13 0 0 0</pose>
        <collision name="crate_wall_left_collision">
          <geometry>
            <box><size>0.01 0.3 0.12</size></box>
          </geometry>
        </collision>
        <visual name="crate_wall_left_visual">
          <geometry>
            <box><size>0.01 0.3 0.12</size></box>
          </geometry>
          <material>
            <ambient>0.82 0.66 0.45 1</ambient>
            <diffuse>0.82 0.66 0.45 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="crate_wall_right">
        <pose>0.145 0 0.13 0 0 0</pose>
        <collision name="crate_wall_right_collision">
          <geometry>
            <box><size>0.01 0.3 0.12</size></box>
          </geometry>
        </collision>
        <visual name="crate_wall_right_visual">
          <geometry>
            <box><size>0.01 0.3 0.12</size></box>
          </geometry>
          <material>
            <ambient>0.82 0.66 0.45 1</ambient>
            <diffuse>0.82 0.66 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3 dynamic blocks resting inside the crate (only non-static parts) -->
    <model name="shelf_block_orange">
      <static>false</static>
      <link name="shelf_block_orange_link">
        <pose>0.9 0.0 0.095 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08e-05</ixx><iyy>2.08e-05</iyy><izz>2.08e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="shelf_block_orange_collision">
          <geometry>
            <box><size>0.03 0.03 0.1</size></box>
          </geometry>
        </collision>
        <visual name="shelf_block_orange_visual">
          <geometry>
            <box><size>0.03 0.03 0.1</size></box>
          </geometry>
          <material>
            <ambient>1 0.45 0 1</ambient>
            <diffuse>1 0.45 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_block_green">
      <static>false</static>
      <link name="shelf_block_green_link">
        <pose>1.0 0.0 0.095 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08e-05</ixx><iyy>2.08e-05</iyy><izz>2.08e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="shelf_block_green_collision">
          <geometry>
            <box><size>0.03 0.03 0.1</size></box>
          </geometry>
        </collision>
        <visual name="shelf_block_green_visual">
          <geometry>
            <box><size>0.03 0.03 0.1</size></box>
          </geometry>
          <material>
            <ambient>0 0.8 0.2 1</ambient>
            <diffuse>0 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_block_blue">
      <static>false</static>
      <link name="shelf_block_blue_link">
        <pose>1.1 0.0 0.095 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08e-05</ixx><iyy>2.08e-05</iyy><izz>2.08e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="shelf_block_blue_collision">
          <geometry>
            <box><size>0.03 0.03 0.1</size></box>
          </geometry>
        </collision>
        <visual name="shelf_block_blue_visual">
          <geometry>
            <box><size>0.03 0.03 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>








