<?xml version="1.0" encoding="utf-8"?>
<robot
  name="mecanum_arm_robot"
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  xmlns:ignition="http://ignitionrobotics.org">

  <xacro:property name="scale" value="0.7" />

  <material name="base_chassis">
    <color rgba="0.16 0.18 0.20 1.0" />
  </material>
  <material name="wheel_black">
    <color rgba="0.05 0.05 0.06 1.0" />
  </material>
  <material name="accent_orange">
    <color rgba="0.95 0.46 0.08 1.0" />
  </material>
  <material name="arm_light_grey">
    <color rgba="0.82 0.83 0.85 1.0" />
  </material>
  <material name="gripper_dark">
    <color rgba="0.18 0.19 0.21 1.0" />
  </material>
  <material name="finger_black">
    <color rgba="0.08 0.08 0.09 1.0" />
  </material>


  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${0.11555 * scale}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin
        xyz="${0.035974 * scale} ${0.020083 * scale} ${6.2148E-05 * scale}"
        rpy="0 0 3.1415" />
      <mass value="${6.4539 * scale**3}" />
      <inertia
        ixx="${0.12648 * scale**5}"
        ixy="${-0.0035153 * scale**5}"
        ixz="${0.00014021 * scale**5}"
        iyy="${0.34337 * scale**5}"
        iyz="${-3.3279E-05 * scale**5}"
        izz="${0.25605 * scale**5}" />
    </inertial>
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 3.1415" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.62745 0.62745 0.62745 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/base_link.STL" />
      </geometry>
    </collision> -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.1415" />
      <geometry>
        <box size="${0.56 * scale} ${0.396 * scale} ${0.13955 * scale}" />
      </geometry>
      <material name="">
        <color rgba="0.62745 0.62745 0.62745 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${0.56 * scale} ${0.396 * scale} ${0.13955 * scale}" />
      </geometry>
    </collision>
  </link>

  <link name="front_right_wheel">
    <inertial>
      <origin
        xyz="${5.5722E-07 * scale} ${1.3698E-07 * scale} ${0.02407 * scale}"
        rpy="0 0 0" />
      <mass value="${0.18185 * scale**3}" />
      <inertia
        ixx="${9.3837E-05 * scale**5}"
        ixy="${8.0211E-08 * scale**5}"
        ixz="${-7.707E-07 * scale**5}"
        iyy="${9.369E-05 * scale**5}"
        iyz="${-4.1837E-07 * scale**5}"
        izz="${0.00016398 * scale**5}" />
    </inertial>
    <visual>
      <origin xyz="0 0 ${-0.05 * scale}" rpy="0 0 0" />
      <geometry>
        <!-- <mesh
          filename="file://$(find robot)/meshes/front_left_wheel.STL"
          scale="1 1 1"/> -->
          <cylinder radius="${0.075 * scale}" length="${0.03 * scale}" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="${0.075 * scale}"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="${0.2305 * scale} ${-0.21325 * scale} ${-0.035 * scale}" rpy="-1.5708 0 0" />
    <parent link="base_link" />
    <child link="front_right_wheel" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="front_left_wheel">
