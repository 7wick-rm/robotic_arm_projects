<?xml version="1.0"?>
<sdf version="1.6">
  <world name="piper_example">
    <scene>
      <grid>true</grid>
    </scene>
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <light name='directionallight' type='directional'>
      <pose>0 0 3 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- Red box: y = -0.25 -->
    <model name="red_box">
      <static>false</static>
      <pose>0.25 -0.25 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000041667</ixx>
            <iyy>0.0000041667</iyy>
            <izz>0.0000041667</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
            <specular>0.5 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Green box: y = 0.00 -->
    <model name="green_box">
      <static>false</static>
      <pose>0.45 0.00 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000041667</ixx>
            <iyy>0.0000041667</iyy>
            <izz>0.0000041667</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.0 1.0 0.0 1</ambient>
            <diffuse>0.0 1.0 0.0 1</diffuse>
            <specular>0.0 0.5 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Blue box: y = +0.25 -->
    <model name="blue_box">
      <static>false</static>
      <pose>0.25 0.25 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000041667</ixx>
            <iyy>0.0000041667</iyy>
            <izz>0.0000041667</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.0 1.0 1</ambient>
            <diffuse>0.0 0.0 1.0 1</diffuse>
            <specular>0.0 0.0 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
     <model name='2*2_blue'>
      <static>false</static>
        <model name="duplo_2x2_blue">
        <link name="link">
          <inertial>
            <mass>0.005</mass>
            <inertia>
              <ixx>0.000001</ixx>
              <iyy>0.000001</iyy>
              <izz>0.000001</izz>
            </inertia>
          </inertial>

          <collision name="collision">
            <geometry>
              <mesh>
                <uri>/home/sathwik/piper_ros2/src/piper_bringup/models/duplo_2x2_blue/meshes/2x2.stl</uri>
                <scale>0.001 0.001 0.001</scale>
              </mesh>
            </geometry>
          </collision>

          <visual name="visual">
            <geometry>
              <mesh>
                <uri>/home/sathwik/piper_ros2/src/piper_bringup/models/duplo_2x2_blue/meshes/2x2.stl</uri>
                <scale>0.001 0.001 0.001</scale>
              </mesh>
            </geometry>
            
            <material>
              <ambient>0.0 0.2 0.8 1</ambient>
              <diffuse>0.0 0.2 0.8 1</diffuse>
              <specular>0.4 0.4 0.4 1</specular> </material>
          </visual>
        </link>
      </model>
      <pose>0.25 0.00 0.026 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

  </world>
</sdf>
